# Copy to .env for local development or standalone hosting. In production on
# the shared Oracle VM these are set as GitHub Actions secrets instead
# (see docs/DEPLOYMENT.md). Everything is optional.

# --- Accounts ----------------------------------------------------------------

# Allow new accounts to be created (true/false).
# REGISTRATION_ENABLED=true

# Require this code to create an account. Recommended on a public server so
# only people you invite can sign up.
# REGISTRATION_CODE=change-me

# Days a sign-in lasts without being used.
# SESSION_TTL_DAYS=30

# Mark session cookies Secure (HTTPS only). Defaults to true in production.
# COOKIE_SECURE=false

# --- Games ---------------------------------------------------------------------

# Only allow games for these Twitch channels (comma-separated).
# ALLOWED_CHANNELS=your_channel

# Delete games nobody has played for this many days.
# ROOM_RETENTION_DAYS=90

# Limits.
# MAX_ROOMS=500
# MAX_ROOMS_PER_USER=5

# --- Server --------------------------------------------------------------------

# PORT=8080
# DATA_DIR=./data
# LOG_LEVEL=info

# Set to true when behind a reverse proxy.
# TRUST_PROXY=false

# Standalone hosting with compose.yaml only: public hostname for HTTPS.
# DOMAIN=hues.example.com

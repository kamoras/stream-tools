# Copy to .env for local development. In production these are set from
# GitHub Actions secrets (see ../../docs/DEPLOYMENT.md).

# --- Invites & admin -------------------------------------------------------------

# Sign-up is invite-only; codes are generated in the shared admin dashboard
# (apps/admin), which calls this app's internal API with this token. In
# production the token is generated on the server automatically.
INTERNAL_API_TOKEN=local-development-token-change-me-0123456789
# INTERNAL_API_PORT=9000

# Days an unused invite code stays valid.
# INVITE_TTL_DAYS=14

# --- Accounts ------------------------------------------------------------------

# Days a sign-in lasts without being used.
# SESSION_TTL_DAYS=30

# Mark session cookies Secure (HTTPS only). Defaults to true in production.
# COOKIE_SECURE=false

# --- Games ---------------------------------------------------------------------

# Only allow games for these Twitch channels (comma-separated).
# ALLOWED_CHANNELS=your_channel

# Delete games nobody has played for this many days.
# ROOM_RETENTION_DAYS=90

# Limits.
# MAX_ROOMS=500
# MAX_ROOMS_PER_USER=5

# --- Server --------------------------------------------------------------------

# PORT=8080
# DATA_DIR=./data
# LOG_LEVEL=info

# Set to true when behind a reverse proxy.
# TRUST_PROXY=false

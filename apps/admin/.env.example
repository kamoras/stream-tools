# Copy to .env for local development. In production these come from GitHub
# Actions secrets and the server-generated internal token (docs/DEPLOYMENT.md).

ADMIN_PASSWORD=change-me-to-something-long
ADMIN_PATH=local-admin
PUBLIC_URL=http://localhost:8081
# Each app's INTERNAL_API_TOKEN and internal API port (32+ characters). These
# match the apps' .env.example files, so all three run side by side.
DBD_BOT_API_TOKEN=local-dbd-bot-token-change-me-0123456789abcdef
DBD_BOT_API_URL=http://localhost:9001
HUES_API_TOKEN=local-hues-token-change-me-0123456789abcdef
HUES_API_URL=http://localhost:9002
# 8080 is the dbd-bot's and 8082 Hues & Cues's locally.
PORT=8081
# COOKIE_SECURE=false

# Copy to .env for local development. In production these come from GitHub
# Actions secrets and the server-generated internal token (docs/DEPLOYMENT.md).

ADMIN_PASSWORD=change-me-to-something-long
ADMIN_PATH=local-admin
PUBLIC_URL=http://localhost:8080
# Must match INTERNAL_API_TOKEN given to each app (32+ characters).
INTERNAL_API_TOKEN=local-development-token-change-me-0123456789
DBD_BOT_API_URL=http://localhost:9001
HUES_API_URL=http://localhost:9002
# PORT=8080
# COOKIE_SECURE=false
